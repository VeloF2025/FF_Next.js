[Unit]
Description=WA Mention Poller (DR/ONT mentions -> FibreFlow)
Documentation=https://github.com/VelocityFibre/FF_Next.js
After=network.target whatsapp-bridge.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/wa-mention-poller
EnvironmentFile=/etc/wa-mention-poller.env
ExecStart=/usr/bin/python3 /opt/wa-mention-poller/poll.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wa-mention-poller
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
