# ============================================================================
# CLASSIFICATION LOGIC
# ============================================================================

def classify_urgency(email: EmailMessage) -> tuple[str, float]:
    """
    Classify email urgency based on keywords and patterns.

    Returns:
        (urgency_level, confidence_score)
    """
    subject_lower = email.subject.lower()
    body_lower = email.body.lower()

    # High urgency keywords
    high_urgency_keywords = [
        "urgent", "asap", "immediately", "critical", "emergency",
        "deadline", "today", "now", "press release", "media"
    ]

    # Medium urgency keywords
    medium_urgency_keywords = [
        "soon", "this week", "important", "please review",
        "follow up", "reminder", "update required"
    ]

    # Check for high urgency
    high_matches = sum(1 for kw in high_urgency_keywords if kw in subject_lower or kw in body_lower)
    if high_matches >= 2:
        return "high", 0.9
    elif high_matches == 1:
        return "high", 0.7

    # Check for medium urgency
    medium_matches = sum(1 for kw in medium_urgency_keywords if kw in subject_lower or kw in body_lower)
    if medium_matches >= 2:
        return "medium", 0.8
    elif medium_matches == 1:
        return "medium", 0.6

    # Default to low urgency
    return "low", 0.7


def classify_category(email: EmailMessage) -> tuple[str, List[str]]:
    """
    Classify email category based on content.

    Returns:
        (category, keywords)
    """
    subject_lower = email.subject.lower()
    body_lower = email.body.lower()
    text = f"{subject_lower} {body_lower}"

    categories = {
        "financial": ["invoice", "payment", "financial", "budget", "cost", "quote", "billing"],
        "meeting": ["meeting", "call", "schedule", "calendar", "appointment", "zoom", "teams"],
        "question": ["question", "clarify", "wondering", "help", "how to", "can you", "?"],
        "update": ["update", "status", "progress", "report", "fyi", "sharing"],
        "action_required": ["please", "need", "required", "must", "should", "action"],
        "legal": ["contract", "agreement", "legal", "terms", "compliance", "regulation"],
        "technical": ["bug", "error", "technical", "issue", "system", "code", "deployment"]
    }

    scores = {}
    for category, keywords in categories.items():
        matches = [kw for kw in keywords if kw in text]
        if matches:
            scores[category] = len(matches)

    if not scores:
        return "general", []

    # Get category with most matches
    best_category = max(scores.items(), key=lambda x: x[1])[0]
    keywords = [kw for kw in categories[best_category] if kw in text]

    return best_category, keywords


def classify_intent(email: EmailMessage) -> str:
    """
    Classify sender's intent.

    Returns:
        Intent classification
    """
    subject_lower = email.subject.lower()
    body_lower = email.body.lower()
    text = f"{subject_lower} {body_lower}"

    # Order matters - check action-requiring intents first
    intents = {
        "request_action": ["please provide", "could you", "need you to", "action required", "kindly"],
        "request_info": ["question", "wondering", "can you provide", "need information", "?"],
        "approve": ["approve", "approval", "sign off", "review and approve"],
        "complain": ["issue", "problem", "concern", "complaint", "not working"],
        "schedule": ["meeting", "call", "schedule", "available", "calendar"],
        "thank": ["thank", "appreciate", "grateful", "thanks"],
        "provide_update": ["update", "fyi", "sharing", "wanted to let you know"]
    }

    for intent, keywords in intents.items():
        if any(kw in text for kw in keywords):
            return intent

    return "inform"


def calculate_priority_score(urgency: str, category: str, requires_response: bool) -> float:
    """Calculate overall priority score."""
    urgency_scores = {"high": 1.0, "medium": 0.6, "low": 0.3}
    category_weights = {
        "financial": 0.9,
        "legal": 0.95,
        "action_required": 0.85,
        "meeting": 0.7,
        "question": 0.6,
        "update": 0.4,
        "general": 0.3,
        "technical": 0.8
    }

    base_score = urgency_scores.get(urgency, 0.5)
    category_weight = category_weights.get(category, 0.5)
    response_bonus = 0.1 if requires_response else 0

    score = (base_score * 0.6) + (category_weight * 0.3) + response_bonus
    return min(score, 1.0)


def estimate_response_time(urgency: str, category: str) -> str:
    """Estimate recommended response timeframe."""
    if urgency == "high":
        if category in ["legal", "financial", "action_required"]:
            return "< 2 hours"
        return "< 4 hours"
    elif urgency == "medium":
        if category in ["question", "meeting"]:
            return "< 24 hours"
        return "< 2 days"
    else:
        if category == "update":
            return "No response needed"
        return "< 1 week"


