"""
Email Intelligence API Routes

Provides endpoints for:
- Email classification (3-tier cascade: rule→heuristic→Claude)
- Email draft generation (Claude + RAG context)
- Email sending (MS Graph)
- Outlook category management

Enhanced for n8n integration on Hostinger VPS.

Author: BOSS Development Team
Created: 2025-11-17
Updated: 2025-11-30 (n8n integration)
"""

import os
import json
import logging
import asyncio
from typing import Dict, Any, List, Optional
from datetime import datetime
from pathlib import Path
from fastapi import APIRouter, HTTPException, Depends, status, Request, BackgroundTasks
from pydantic import BaseModel, Field

from api.auth import verify_api_key
from api.rate_limiting import limiter

# Import EmailClassifier (3-tier cascade)
from lib.email.email_classifier import EmailClassifier, EmailCategory, Classification

# Import DraftGenerator
from agents.communication.draft_generator import DraftGenerator

# Import MS Graph client
from lib.msgraph.client import MSGraphClient
from lib.msgraph.models import Email, EmailDraft, EmailImportance

# Import IMAP client
from lib.imap.client import IMAPClient

logger = logging.getLogger(__name__)

# Data directory for config files
DATA_DIR = Path(__file__).parent.parent.parent.parent / "data"

router = APIRouter(prefix="/email", tags=["Email Intelligence"])

# Initialize components lazily to avoid startup issues
_email_classifier: Optional[EmailClassifier] = None
_draft_generator: Optional[DraftGenerator] = None
_msgraph_clients: Dict[str, MSGraphClient] = {}
_imap_clients: Dict[str, IMAPClient] = {}


def load_msgraph_accounts() -> List[Dict[str, Any]]:
    """
    Load MS Graph accounts from config file.

    Returns:
        List of account configurations with credentials
    """
    config_file = DATA_DIR / "msgraph_accounts.json"

    if config_file.exists():
        try:
            with open(config_file, "r") as f:
                data = json.load(f)
            accounts = data.get("accounts", [])
            enabled = [a for a in accounts if a.get("enabled", True)]
            logger.info(f"Loaded {len(enabled)} enabled MS Graph accounts from config")
            return enabled
        except Exception as e:
            logger.error(f"Error loading MS Graph accounts: {e}")

    # Fallback to environment variables
    if all([os.getenv("MS_GRAPH_CLIENT_ID"),
            os.getenv("MS_GRAPH_CLIENT_SECRET"),
            os.getenv("MS_GRAPH_TENANT_ID")]):
        logger.info("Using MS Graph credentials from environment variables")
        return [{
            "account_id": "default",
            "client_id": os.getenv("MS_GRAPH_CLIENT_ID"),
            "client_secret": os.getenv("MS_GRAPH_CLIENT_SECRET"),
            "tenant_id": os.getenv("MS_GRAPH_TENANT_ID"),
            "user_email": os.getenv("MS_GRAPH_USER_EMAIL"),
            "display_name": "Default MS Graph Account",
            "enabled": True
        }]

    logger.warning("No MS Graph accounts configured")
    return []


def load_imap_accounts() -> List[Dict[str, Any]]:
    """
    Load IMAP accounts from config file.

    Returns:
        List of account configurations with credentials
    """
    config_file = DATA_DIR / "imap_accounts.json"

    if config_file.exists():
        try:
            with open(config_file, "r") as f:
                data = json.load(f)
            accounts = data.get("accounts", [])
            enabled = [a for a in accounts if a.get("enabled", True)]
            logger.info(f"Loaded {len(enabled)} enabled IMAP accounts from config")
            return enabled
        except Exception as e:
            logger.error(f"Error loading IMAP accounts: {e}")

    logger.warning("No IMAP accounts configured")
    return []


async def get_imap_client(account: Dict[str, Any]) -> IMAPClient:
    """
    Get or create IMAPClient instance for specified account.

    Args:
        account: Account configuration dict with host, port, username, password

    Returns:
        IMAPClient instance
    """
    global _imap_clients

    account_id = account.get("account_id", "default")

    # Check cache
    if account_id in _imap_clients:
        return _imap_clients[account_id]

    # Create new client
    client = IMAPClient(
        imap_server=account.get("host"),
        imap_port=account.get("port", 993),
        smtp_server=account.get("smtp_host"),
        smtp_port=account.get("smtp_port", 587),
        username=account.get("username"),
        password=account.get("password"),
        use_ssl=True
    )
    await client.connect()
    _imap_clients[account_id] = client
    logger.info(f"IMAPClient connected for account: {account.get('display_name', account_id)}")

    return client


def get_email_classifier() -> EmailClassifier:
    """Get or create EmailClassifier instance."""
    global _email_classifier
    if _email_classifier is None:
        api_key = os.getenv("ANTHROPIC_API_KEY")
        _email_classifier = EmailClassifier(anthropic_api_key=api_key)
        logger.info("EmailClassifier initialized (3-tier cascade)")
    return _email_classifier


def get_draft_generator() -> DraftGenerator:
    """Get or create DraftGenerator instance."""
    global _draft_generator
    if _draft_generator is None:
        _draft_generator = DraftGenerator()
        logger.info("DraftGenerator initialized")
    return _draft_generator


async def get_msgraph_client(account_id: Optional[str] = None) -> MSGraphClient:
    """
    Get or create MSGraphClient instance for specified account.

    Args:
        account_id: Specific account ID to use, or None for first available

    Returns:
        MSGraphClient instance

    Raises:
        HTTPException: If no MS Graph accounts are configured
    """
    global _msgraph_clients

    # Load accounts from config
    accounts = load_msgraph_accounts()

    if not accounts:
        raise HTTPException(
            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
            detail="No MS Graph accounts configured. Add accounts to data/msgraph_accounts.json or set MS_GRAPH_* environment variables."
        )

    # Find the requested account or use first available
    account = None
    if account_id:
        account = next((a for a in accounts if a.get("account_id") == account_id), None)
        if not account:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"MS Graph account '{account_id}' not found"
            )
    else:
        account = accounts[0]

    cache_key = account.get("account_id", "default")

    # Check cache
    if cache_key in _msgraph_clients:
        return _msgraph_clients[cache_key]

    # Create new client
    client = MSGraphClient(
        client_id=account.get("client_id"),
        client_secret=account.get("client_secret"),
        tenant_id=account.get("tenant_id"),
        user_email=account.get("user_email")
    )
    await client.connect()
    _msgraph_clients[cache_key] = client
    logger.info(f"MSGraphClient connected for account: {account.get('display_name', cache_key)}")

    return client


async def get_all_msgraph_clients() -> List[tuple[str, MSGraphClient]]:
    """
    Get all configured MS Graph clients.

    Returns:
        List of (account_id, client) tuples
    """
    accounts = load_msgraph_accounts()
    clients = []

    for account in accounts:
        account_id = account.get("account_id", "default")
        try:
            client = await get_msgraph_client(account_id)
            clients.append((account_id, client))
        except Exception as e:
            logger.error(f"Failed to connect account {account_id}: {e}")

    return clients


