class EmailMessage(BaseModel):
    """Email message for classification/processing"""
    from_address: str = Field(..., description="Sender email address")
    to_addresses: List[str] = Field(..., description="Recipient email addresses")
    subject: str = Field(..., description="Email subject")
    body: str = Field(..., description="Email body text")
    cc_addresses: Optional[List[str]] = Field(default=None, description="CC addresses")
    received_time: Optional[str] = Field(default=None, description="Email received timestamp")


class ClassifyEmailRequest(BaseModel):
    """Request model for email classification"""
    email: EmailMessage = Field(..., description="Email to classify")


class ClassifyEmailResponse(BaseModel):
    """Response model for email classification"""
    urgency: str = Field(..., description="Urgency level: high|medium|low")
    category: str = Field(..., description="Email category")
    intent: str = Field(..., description="Sender's intent")
    priority_score: float = Field(ge=0.0, le=1.0, description="Priority score 0-1")
    requires_response: bool = Field(..., description="Whether response is required")
    estimated_response_time: str = Field(..., description="Recommended response timeframe")
    keywords: List[str] = Field(default=[], description="Key terms identified")
    confidence: float = Field(ge=0.0, le=1.0, description="Classification confidence")


class DraftEmailRequest(BaseModel):
    """Request model for email draft generation"""
    email: EmailMessage = Field(..., description="Email to respond to")
    context: Optional[Dict[str, Any]] = Field(default=None, description="Additional context from enrichment")
    tone: str = Field(default="professional", description="Tone: professional|friendly|formal")
    instructions: Optional[str] = Field(default=None, description="Special instructions for draft")


class DraftEmailResponse(BaseModel):
    """Response model for email draft"""
    draft_id: str = Field(..., description="Unique draft identifier")
    to: List[str] = Field(..., description="Recipients")
    subject: str = Field(..., description="Draft subject")
    body: str = Field(..., description="Draft body")
    tone: str = Field(..., description="Tone used")
    confidence: float = Field(ge=0.0, le=1.0, description="Draft quality confidence")
    created_at: str = Field(..., description="Draft creation timestamp")


class SendEmailRequest(BaseModel):
    """Request model for sending email"""
    draft_id: Optional[str] = Field(default=None, description="Draft ID to send")
    to: List[str] = Field(..., description="Recipients")
    subject: str = Field(..., description="Email subject")
    body: str = Field(..., description="Email body")
    cc: Optional[List[str]] = Field(default=None, description="CC recipients")
    attachments: Optional[List[str]] = Field(default=None, description="Attachment file paths")


class SendEmailResponse(BaseModel):
