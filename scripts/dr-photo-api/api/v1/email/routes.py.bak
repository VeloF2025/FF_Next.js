# API ENDPOINTS
# ============================================================================

@router.post("/classify", response_model=ClassifyEmailResponse, dependencies=[Depends(verify_api_key)])
@limiter.limit("30/minute")
async def classify_email(request: Request, classify_request: ClassifyEmailRequest) -> ClassifyEmailResponse:
    """
    Classify email using 3-tier cascade (rule→heuristic→Claude).

    This endpoint analyzes an email and provides:
    - Urgency level (high/medium/low)
    - Category classification (Urgent, Client Inquiry, Financial, etc.)
    - Sender's intent
    - Priority score
    - Response requirements
    - Classification method used (rule-based, heuristic, ai)

    **Cost Optimization:**
    - Tier 1 (rule-based): FREE, ~70% of emails
    - Tier 2 (heuristic): FREE, ~20% more
    - Tier 3 (Claude AI): PAID (~$0.002), only ~10% complex cases

    **Example Request:**
    ```json
    {
        "email": {
            "from_address": "john@blitz.com",
            "to_addresses": ["boss@example.com"],
            "subject": "URGENT: Q4 Financial Review Required",
            "body": "Please review and approve the attached Q4 financials ASAP..."
        }
    }
    ```
    """
    logger.info(f"Classifying email from: {classify_request.email.from_address}")

    try:
        # Get classifier instance
        classifier = get_email_classifier()

        # Convert request to classifier format
        email_data = {
            "subject": classify_request.email.subject,
            "body": classify_request.email.body,
            "sender": classify_request.email.from_address,
            "recipients": classify_request.email.to_addresses,
            "cc_recipients": classify_request.email.cc_addresses or [],
            "has_attachments": False,  # Not available in request
            "importance": "normal"
        }

        # Run 3-tier classification
        classification = await classifier.classify(email_data)

        # Map EmailCategory to urgency
        urgency_map = {
            EmailCategory.URGENT: "high",
            EmailCategory.ACTION_REQUIRED: "medium",
            EmailCategory.FINANCIAL: "medium",
            EmailCategory.CLIENT_INQUIRY: "medium",
            EmailCategory.INTERNAL: "low",
            EmailCategory.FYI: "low",
            EmailCategory.SPAM: "low"
        }
        urgency = urgency_map.get(classification.category, "medium")

        # Determine if response required
        requires_response = classifier.should_generate_draft(classification.category)

        # Calculate priority score based on category and confidence
        priority_map = {
            EmailCategory.URGENT: 0.95,
            EmailCategory.FINANCIAL: 0.85,
            EmailCategory.ACTION_REQUIRED: 0.80,
            EmailCategory.CLIENT_INQUIRY: 0.75,
            EmailCategory.INTERNAL: 0.50,
            EmailCategory.FYI: 0.30,
            EmailCategory.SPAM: 0.10
        }
        priority_score = priority_map.get(classification.category, 0.50) * classification.confidence

        # Also run legacy analysis for intent and keywords
        intent = classify_intent(classify_request.email)
        _, keywords = classify_category(classify_request.email)
        estimated_response_time = estimate_response_time(urgency, classification.category.value)

        response = ClassifyEmailResponse(
            urgency=urgency,
            category=classification.category.value,
            intent=intent,
            priority_score=round(priority_score, 2),
            requires_response=requires_response,
            estimated_response_time=estimated_response_time,
            keywords=keywords,
            confidence=classification.confidence
        )

        logger.info(
            f"✅ Email classified via {classification.method}: "
            f"{classification.category.value} (confidence: {classification.confidence:.2f})"
        )

        return response

    except Exception as e:
        logger.error(f"Email classification failed: {e}", exc_info=True)
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Email classification failed: {str(e)}"
        )


@router.post("/draft", response_model=DraftEmailResponse, dependencies=[Depends(verify_api_key)])
@limiter.limit("10/minute")
async def draft_email(request: Request, draft_request: DraftEmailRequest) -> DraftEmailResponse:
    """
    Generate email draft using Claude with RAG context.

    Uses DraftGenerator which:
    - Integrates Claude API for intelligent drafting
    - Supports personality profiles from learning history
    - Uses RAG context for relevant document references
    - Auto-detects complexity for cost optimization

    **Effort Optimization (Claude Opus 4.5):**
    - routine: 76%+ token savings (simple acknowledgments)
    - standard: Best cost/quality balance (default)
    - complex: Thorough analysis (financial/legal)

    **Example Request:**
    ```json
    {
        "email": {
            "from_address": "john@blitz.com",
            "to_addresses": ["boss@example.com"],
            "subject": "Q4 Financial Review",
            "body": "Please review the attached Q4 financials..."
        },
        "context": {
            "sender_info": {"name": "John Smith", "company": "Blitz"},
            "relevant_docs": [{"title": "Q4 Report", "summary": "..."}]
        },
        "tone": "professional"
    }
    ```
    """
    logger.info(f"Generating draft for email from: {draft_request.email.from_address}")

    try:
        # Get draft generator
        generator = get_draft_generator()

        # Convert request email to internal Email model
        email = Email(
            message_id=f"incoming_{datetime.utcnow().timestamp()}",
            subject=draft_request.email.subject,
            body=draft_request.email.body,
            sender=draft_request.email.from_address,
            sender_name=draft_request.email.from_address.split("@")[0].replace(".", " ").title(),
            to_recipients=draft_request.email.to_addresses,
            cc_recipients=draft_request.email.cc_addresses or [],
            received_at=datetime.utcnow() if not draft_request.email.received_time else datetime.fromisoformat(draft_request.email.received_time),
            is_read=True,
            has_attachments=False
        )

        # Prepare context
        context = draft_request.context or {}

        # Auto-detect complexity from context/classification
        complexity = DraftGenerator.detect_complexity(context)
        logger.info(f"Auto-detected complexity: {complexity}")

        # Generate draft using Claude
        draft = await generator.generate_draft(
            email=email,
            context=context,
            tone=draft_request.tone,
            user_name="Hein van Vuuren",  # TODO: Make configurable
            complexity=complexity
        )

        # Create response
        draft_id = f"draft_{datetime.utcnow().timestamp()}"

        response = DraftEmailResponse(
            draft_id=draft_id,
            to=draft.to_recipients,
            subject=draft.subject,
            body=draft.body,
            tone=draft_request.tone,
            confidence=draft.confidence,
            created_at=draft.generated_at.isoformat() if draft.generated_at else datetime.utcnow().isoformat()
        )

        logger.info(f"✅ Draft generated: {draft_id} (complexity={complexity}, confidence={draft.confidence:.2f})")

        return response

    except Exception as e:
        logger.error(f"Email draft generation failed: {e}", exc_info=True)
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Email draft generation failed: {str(e)}"
        )


@router.post("/send", response_model=SendEmailResponse, dependencies=[Depends(verify_api_key)])
@limiter.limit("5/minute")
async def send_email(request: Request, send_request: SendEmailRequest) -> SendEmailResponse:
    """
    Send email via MS Graph (direct send, no approval).

    Use /send-approved for approved drafts from n8n workflow.
    """
    logger.info(f"Sending email to: {send_request.to}")

    try:
        # Get MS Graph client
        client = await get_msgraph_client()

        # Send via MS Graph
        await client.send_email(
            to=send_request.to,
            subject=send_request.subject,
            body=send_request.body,
            cc=send_request.cc,
            is_html=True
        )

        message_id = f"sent_{datetime.utcnow().timestamp()}"

        response = SendEmailResponse(
            message_id=message_id,
            status="sent",
            timestamp=datetime.utcnow().isoformat(),
            recipients=send_request.to
        )

        logger.info(f"✅ Email sent via MS Graph: {message_id}")

        return response

    except Exception as e:
        logger.error(f"Email sending failed: {e}", exc_info=True)
        raise HTTPException(
            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
            detail=f"Email sending failed: {str(e)}"
        )


