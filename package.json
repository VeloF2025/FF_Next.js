    "express": "^5.1.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.12",
    "glob": "^11.0.3",
    "html5-qrcode": "^2.3.8",
    "http-proxy-middleware": "^3.0.5",
    "isomorphic-dompurify": "^3.0.0-rc.2",
    "jose": "^6.1.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "livekit-client": "^2.16.1",
    "livekit-server-sdk": "^2.15.0",
    "lucide-react": "^0.279.0",
    "next": "14.2.18",
    "nodemailer": "^8.0.1",
    "openai": "^6.25.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pino": "^9.9.1",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "pizzip": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.45.0",
    "react-hot-toast": "^2.6.0",
    "reactflow": "^11.11.4",
    "recharts": "^3.6.0",
    "resend": "^6.4.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "sonner": "^2.0.7",
    "swr": "^2.3.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5",
