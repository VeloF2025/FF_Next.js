{
  "name": "fibreflow-react",
  "version": "1.0.0",
  "description": "FibreFlow React Migration - Modern React application migrated from Angular",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "next dev",
    "dev:api": "node server.mjs",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "build:turbo": "next build --turbo",
    "start": "next start",
    "postinstall": "node scripts/setup-eslint-plugin.js",
    "analyze": "ANALYZE=true next build",
    "analyze:bundle": "BUNDLE_ANALYZE=true next build",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:component": "vitest --run src/components src/modules",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:visual": "playwright test --grep @visual",
    "test:e2e:mobile": "playwright test --grep @mobile",
    "test:wa-monitor": "tsx src/modules/wa-monitor/tests/integration.test.ts",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:strict": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "ci": "bash scripts/ci-local.sh",
    "ci:quick": "bash scripts/ci-local.sh --quick",
    "db:migrate": "tsx scripts/migrations/run.ts",
    "db:seed": "tsx scripts/setupNeonDatabase.ts seed",
    "db:validate": "tsx scripts/setupNeonDatabase.ts validate",
    "db:setup": "tsx scripts/setupNeonDatabase.ts setup",
    "db:test": "tsx scripts/run-database-tests.ts",
    "db:test:suite": "tsx scripts/database-testing-suite.ts",
    "db:test:schema": "tsx scripts/schema-validation-suite.ts",
    "db:optimize": "tsx neon/scripts/run-performance-migration.ts",
    "antihall": "node scripts/antihall-validator.cjs",
    "antihall:parse": "node scripts/antihall-validator.cjs parse",
    "antihall:check": "node scripts/antihall-validator.cjs check",
    "antihall:find": "node scripts/antihall-validator.cjs find",
    "antihall:stats": "node scripts/antihall-validator.cjs stats",
    "debt:check": "python3 scripts/automation/detect_code_smells.py src --output markdown",
    "debt:deps": "python3 scripts/automation/analyze_dependencies.py package.json",
    "debt:report": "python3 scripts/automation/detect_code_smells.py src --output markdown > docs/tech-debt-report.md && python3 scripts/automation/analyze_dependencies.py package.json >> docs/tech-debt-report.md",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "check:db-connections": "node scripts/check-db-connections.mjs",
    "test:integration": "vitest run src/tests/api-integration",
    "test:assets": "vitest --config vitest.integration.config.ts --run src/modules/assets/__tests__/integration.test.ts",
    "test:no-direct-db": "vitest run src/tests/api-integration/no-direct-db.test.ts",
    "test:logger": "tsx scripts/test-logger.ts",
    "db:migrate:realtime": "node scripts/run-realtime-migration.js",
    "embed-manual": "node scripts/embed-manual-content.js"
  },
  "keywords": [
    "react",
    "typescript",
    "fibreflow",
    "migration",
    "nextjs"
  ],
  "author": "FibreFlow Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@arcjet/next": "^1.0.0-beta.15",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ericblade/quagga2": "^1.12.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.3.0",
    "@livekit/components-react": "^2.9.17",
    "@livekit/components-styles": "^1.2.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-data-grid": "^8.11.2",
    "@neondatabase/serverless": "^1.0.1",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.85.5",
    "@testing-library/dom": "^9.3.4",
    "@xyflow/react": "^12.10.1",
    "axios": "^1.13.2",
