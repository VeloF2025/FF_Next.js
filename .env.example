# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Neon Database Configuration
NEON_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
NEON_POOL_QUERY_LIMIT=1000

# Internal Authentication (JWT)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Clerk Authentication (Optional - Legacy)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Arcjet Security (Optional - for bot protection & rate limiting)
# Sign up for free at https://arcjet.com
ARCJET_KEY=ajkey_your_arcjet_key_here

# Next.js Public Environment Variables
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Server Configuration
USE_LEGACY_SERVER=false
PORT=3000

# Development & Debugging
AUTH_BYPASS=false
LOG_LEVEL=info
NODE_ENV=development

# Optional: Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Optional: External Services
OPENAI_API_KEY=
# Set true to re-transcribe Teams recordings with Whisper after recording download.
# Preserves Afrikaans/code-switched transcript in meeting_transcripts format=whisper-af
# and stores English translation in meetings.raw_transcript for LLM summaries.
WHISPER_TEAMS_RECORDINGS=false
# Optional: route OpenAI calls through Cloudflare AI Gateway for caching + observability
# OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/9cc447813a4d879764f613a2c35baf95/fibreflow-ai/openai
OPENAI_BASE_URL=
REDIS_URL=

# Cortex Remote MCP consent callback (server-only)
CORTEX_REMOTE_MCP_URL=http://127.0.0.1:7414
# Dedicated to Cortex; never reuse FF_MCP_CALLBACK_SECRET.
CORTEX_MCP_CALLBACK_SECRET=
# Also issue Cortex a read-only FibreFlow API credential when a user consents, so its
# tools can read FibreFlow as that person. The widest grant in this flow: the consenting
# user's own read access, nothing more, but that is everything they can see in the app.
# Must be exactly `true`; anything else leaves it off. The consent screen states the
# grant whenever this is on. Off everywhere until deliberately enabled.
CORTEX_FF_API_ENABLED=false

# Optional: Feature Flags
NEXT_PUBLIC_ENABLE_PWA=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG=false

# WhatsApp Feedback Service (for QA feedback messages)
# wa-feedback (port 8092) proxies to bridge-2 (8083) using 063 841 2276
WA_FEEDBACK_URL=http://100.96.203.105:8092

# WAHA WhatsApp API (for ticketing notifications)
WAHA_API_URL=https://waha.example.com
WAHA_API_KEY=your_waha_api_key
WAHA_SESSION_NAME=default
WAHA_TIMEOUT_MS=30000
WAHA_RETRY_ATTEMPTS=3

# QContact Integration (for ticketing sync)
QCONTACT_API_URL=https://api.qcontact.example.com
QCONTACT_API_KEY=your_qcontact_api_key
QCONTACT_SYNC_INTERVAL_MS=60000
QCONTACT_WEBHOOK_SECRET=your_webhook_secret

# Firebase Storage (for ticketing attachments)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_STORAGE_BUCKET=your_storage_bucket.appspot.com
FIREBASE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----"

# Sage Business Cloud Accounting (South Africa)
# Register at https://developer.sage.com/ to get credentials
SAGE_CLIENT_ID=your_sage_client_id
SAGE_CLIENT_SECRET=your_sage_client_secret
SAGE_COMPANY_ID=your_sage_company_id
SAGE_BASE_URL=https://accounting.sageone.co.za
SAGE_API_VERSION=2.0.0
SAGE_REDIRECT_URI=https://app.fibreflow.app/api/sage/oauth/callback

# Cron Job Secret (for scheduled sync tasks)
CRON_SECRET=your_cron_secret_for_scheduled_jobs
# HMAC secret for fleet portal session token signing (generate with: openssl rand -hex 32)
PORTAL_SESSION_SECRET=
# HMAC secret for /my (attendance) portal session cookie — must be distinct
# from PORTAL_SESSION_SECRET so the two portals can't share sessions.
# Generate with: openssl rand -hex 32
MY_PORTAL_SESSION_SECRET=

# QField Plugin API Key (for real-time photo validation)
QFIELD_PLUGIN_API_KEY=your_secure_api_key_here

# Error tracking (Bugsink). Leave SENTRY_ENABLED unset to keep SDK dark.
SENTRY_ENABLED=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time: release tracking + source-map upload
SENTRY_AUTH_TOKEN=
SENTRY_URL=https://errors.isaflow.co.za/
SENTRY_ORG=isaflow-platform
SENTRY_PROJECT=fibreflow
NEXT_PUBLIC_GIT_SHA=

# SMTP — used by forgot-password, procurement RFQs, and receipts notifications.
# The host/credentials below are shared by all email senders; the From address
# is not (see SMTP_FROM_AUTH).
SMTP_HOST=smtp.velocityfibre.co.za
SMTP_PORT=465
SMTP_USER=procurement@velocityfibre.co.za
SMTP_PASS=your_smtp_password
# From address for procurement RFQs (suppliers reply to it) and receipts.
SMTP_FROM=procurement@velocityfibre.co.za
# From address for auth mail (password reset). Kept separate from SMTP_FROM so
# reset emails are not branded as the procurement mailbox. Optional — defaults
# to 'FibreFlow <noreply@velocityfibre.co.za>'. Keep this on a domain whose SPF
# authorises the relay above; fibreflow.app publishes no SPF record.
SMTP_FROM_AUTH=
# Optional. Port 465 is implicit TLS and connects encrypted whether or not this
# is set; set to 'true' only for a relay doing implicit TLS on some other port.
SMTP_SECURE=
# Set to 'false' only when the SMTP host has an expired/self-signed cert.
SMTP_REJECT_UNAUTHORIZED=

# Receipts notifications — accounting inbox for /my receipt submissions
# and /staff approvals. Defaults to receipts@velocityfibre.co.za.
RECEIPTS_EMAIL_TO=receipts@velocityfibre.co.za

# Where to email a failure alert when the 06:00 per-group non-activation report
# builds its workbooks but cannot deliver them. Email rather than WhatsApp is
# the primary channel here because a dead WhatsApp bridge is the exact failure
# being reported. Unset = no email alert (the WhatsApp infra group still gets
# one, when the bridge is reachable). Comma-separate for several recipients.
REPORT_ALERT_EMAIL_TO=ai@velocityfibre.co.za

# Where to email infra alerts from /api/cron/wa-bridge-health (WhatsApp bridge
# down, logged out, or unreachable). Falls back to REPORT_ALERT_EMAIL_TO when
# unset, so the existing address keeps working. Email is primary for the same
# reason as above: the bridge is what the alert is about.
INFRA_ALERT_EMAIL_TO=ai@velocityfibre.co.za

# Health endpoint of the unified WhatsApp bridge, probed by the cron above. The
# probe deliberately runs off-box (on velo, not the VPS) so it still fires when
# the VPS itself is unreachable, not just when the bridge is unhealthy.
WA_BRIDGE_HEALTH_URL=http://72.61.197.178:8083/health

# Velocity review export — server-only HighLevel private integration with
# contacts.read and contacts.write. Keep these values deployment-local; the
# adapter preserves GHL DND and tags by using dedicated Contacts tag endpoints.
VELOCITY_GHL_PRIVATE_INTEGRATION_TOKEN=
VELOCITY_GHL_LOCATION_ID=
VELOCITY_GHL_FIELD_DR_NUMBER_ID=
VELOCITY_GHL_FIELD_EVENT_DATE_ID=
VELOCITY_GHL_FIELD_SOURCES_ID=
VELOCITY_GHL_FIELD_EXPORT_KEY_ID=
# HMAC secret for redacted customer-phone fingerprints (generate with openssl rand -hex 32).
VELOCITY_REVIEW_PHONE_HMAC_SECRET=
# Operational recipient(s) for the redacted export summary; comma-separate if needed.
VELOCITY_REVIEW_SUMMARY_TO=
