# Next.js 15 Environment Variables
# Copy this file to .env.local and fill in your values

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database (Supabase on Velocity since the 2026-04-18 cutover; Neon is retired)
# Runtime connection — uses the least-privilege `fibreflow_user` role.
DATABASE_URL=postgresql://fibreflow_user:password@localhost:5437/fibreflow

# Optional — used only by `npm run db:migrate` (scripts/migrations/run.ts).
# Must be a superuser / schema-owner URL because migrations do DDL
# (CREATE TABLE, ALTER TABLE) which `fibreflow_user` can't do.
# When unset, the runner falls back to DATABASE_URL and will fail on
# DDL with "permission denied for schema public".
# On Velocity, this is the `postgres` superuser against the same DB.
# DATABASE_URL_MIGRATIONS=postgresql://postgres:PASSWORD@localhost:5437/fibreflow

NEON_API_KEY=your_neon_api_key  # legacy — only for the old pre-migration snapshot script

# VF Server Storage (replaces Firebase Storage)
# Set to true to use VF Server storage (port 8091), false for local storage
NEXT_PUBLIC_USE_VF_STORAGE=false
# VF Server storage URL (only needed if NEXT_PUBLIC_USE_VF_STORAGE=true)
VF_STORAGE_URL=http://100.96.203.105:8091
# Local file storage path (default: /var/www/fibreflow/uploads)
FILE_STORAGE_PATH=/var/www/fibreflow/uploads
# Local file storage URL prefix (default: /uploads)
FILE_STORAGE_URL=/uploads

# Performance Monitoring (optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_PPR=false
NEXT_PUBLIC_ENABLE_REACT_COMPILER=true

# Fibertime SharePoint OES Sync
# Azure AD public client app ID (device code flow) — obtain from Hein / Azure Portal
FIBERTIME_SP_CLIENT_ID=
# OAuth2 refresh token for reporting@velocityfibre.co.za
# Run: npx ts-node -r tsconfig-paths/register -P tsconfig.json scripts/fibertime-device-auth.ts
FIBERTIME_SP_REFRESH_TOKEN=