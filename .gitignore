# Generated documentation and runtime data
docs/wa-digests/
docs/weekly-dev-reports/
# docs/schema/ contains DATABASE_SCHEMA_INDEX.md (keep tracked)

# Fleet tracking portal logins (Cartrack / Netstar / Ituran). The file was
# untracked but NOT ignored, so a single `git add .` would have committed four
# live sets of credentials. Leading slash anchors it to the repo root — a bare
# `docs/Fleet` would also match any nested docs/Fleet path.
/docs/Fleet

# Private operational review artifacts (may contain staff names)
/.private/hs-operational-rollout/

# Claude Code local-only (session state, not team-shared)
.claude/session/
.claude/metrics/
.claude/settings.local.json
.claude/worktrees/

# Python cache
scripts/__pycache__/

# Local uploads and test artifacts
public/uploads/qa-photos/
tests/e2e-results/
# Anchored to the repo root. Unanchored, `metrics/` matches a directory of that
# name at ANY depth, which silently excluded src/modules/metrics/ and would
# swallow any new file under pages/api/procurement/metrics/ (its existing
# aggregate.ts survives only because already-tracked files ignore .gitignore).
/metrics/
.next-backup*

# auto-improve-loop iteration log
.claude/auto-improve-loop.log

# CodeGraph local index (pilot — never commit)
.codegraph/
# Benchmark raw per-run JSON (large; keep only parsed CSV + results.md)
docs/superpowers/benchmarks/2026-05-30-codegraph/raw/

# Never track the literal-\$HOME mistake (Claude session logs leaked secrets — #1830)
$HOME/

# Python bytecode (apps/ff_mcp)
__pycache__/
*.py[cod]
