# FibreFlow Production Service — Hardened by Gene 2026-03-11 SAST
[Unit]
Description=FibreFlow Next.js Application (Production)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=velo
Group=velo
WorkingDirectory=/home/velo/fibreflow-production
# Pre-start guard: verify .next/BUILD_ID exists, rebuild if missing
ExecStartPre=+/usr/local/bin/fibreflow-prestart /home/velo/fibreflow-production
ExecStart=/usr/bin/npm start -- -p 3000

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=2min
StartLimitBurst=5

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000

# Logging
StandardOutput=append:/var/log/fibreflow-production.log
StandardError=append:/var/log/fibreflow-production.error.log

# === SECURITY HARDENING ===
NoNewPrivileges=yes
PrivateTmp=yes
ReadWritePaths=/home/velo/fibreflow-production /var/log
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=4G
CPUQuota=80%
TasksMax=512
PrivateDevices=yes
DevicePolicy=strict
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
