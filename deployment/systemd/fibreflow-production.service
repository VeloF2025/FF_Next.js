[Unit]
Description=FibreFlow Production Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=velo
Group=velo
WorkingDirectory=/home/velo/fibreflow-production
ExecStart=/usr/bin/npm start -- -p 3000

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=2min
StartLimitBurst=5

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000

# Logging
StandardOutput=append:/var/log/fibreflow-production.log
StandardError=append:/var/log/fibreflow-production.error.log

# === SECURITY HARDENING ===
# Capability restrictions
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID

# Isolation
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes

# Device access
DevicePolicy=strict
DeviceAllow=/dev/null rw
DeviceAllow=/dev/zero rw
DeviceAllow=/dev/full rw
DeviceAllow=/dev/random r
DeviceAllow=/dev/urandom r

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes

# Resource limits
MemoryMax=2G
CPUQuota=80%
TasksMax=512

# Writable paths (application requires these)
ReadWritePaths=/home/velo/fibreflow-production /var/log

[Install]
WantedBy=multi-user.target
