{
  "version": "2.0",
  "updated": "2026-01-16",
  "description": "QA evaluation steps for DR photo verification using VLM AI (10 steps - ONT/UPS barcodes are scanned, not photographed)",
  "note": "ONT and UPS serial numbers are captured via barcode scanning and stored in ont_serial_scanned and ups_serial_scanned fields",
  "steps": [
    {
      "step_number": 1,
      "step_name": "house_photo",
      "step_label": "House Photo",
      "photo_types": ["ph_prop", "ph_sign1", "ph_drop", "ph_outs"],
      "criteria": "Clear photo of the house/property for location verification"
    },
    {
      "step_number": 2,
      "step_name": "cable_from_pole",
      "step_label": "Cable from Pole",
      "photo_types": ["ph_pole", "ph_cbl_r"],
      "criteria": "Photo showing cable span from utility pole to house"
    },
    {
      "step_number": 3,
      "step_name": "cable_entry_outside",
      "step_label": "Cable Entry Outside",
      "photo_types": ["ph_entry_out", "ph_hm_ln"],
      "criteria": "Close-up of cable entry point from exterior (CRITICAL - 70% field failure rate)"
    },
    {
      "step_number": 4,
      "step_name": "cable_entry_inside",
      "step_label": "Cable Entry Inside",
      "photo_types": ["ph_entry_in", "ph_hm_en"],
      "criteria": "Inside view of cable entry and routing toward ONT area"
    },
    {
      "step_number": 5,
      "step_name": "wall_installation",
      "step_label": "Wall for Installation",
      "photo_types": ["ph_wall"],
      "criteria": "Wall with mounting bracket and power outlet visible"
    },
    {
      "step_number": 6,
      "step_name": "ont_back",
      "step_label": "ONT Back After Install",
      "photo_types": ["ph_ont", "ph_ont_back", "ph_bl"],
      "criteria": "Back of ONT showing fiber and power connections"
    },
    {
      "step_number": 7,
      "step_name": "power_meter",
      "step_label": "Power Meter Reading",
      "photo_types": ["ph_powm", "ph_powm1", "ph_powm2"],
      "criteria": "Clear power meter display showing dBm reading (must be under -24 dBm)"
    },
    {
      "step_number": 8,
      "step_name": "final_installation",
      "step_label": "Final Installation",
      "photo_types": ["ph_after", "ph_final"],
      "criteria": "Wide shot showing ONT mounted, GIZZU/UPS connected, neat cable management"
    },
    {
      "step_number": 9,
      "step_name": "green_lights",
      "step_label": "Green Lights on ONT",
      "photo_types": ["ph_lights", "ph_led"],
      "criteria": "ONT front panel with at least 4 indicator lights illuminated"
    },
    {
      "step_number": 10,
      "step_name": "signature",
      "step_label": "Signature",
      "photo_types": ["ph_sign2", "ph_signature"],
      "criteria": "Customer signature on completion form"
    }
  ]
}
