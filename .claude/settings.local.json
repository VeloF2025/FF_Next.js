            "command": "npx ts-node .claude/hooks/token-tracker.ts 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Tracking tokens..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
