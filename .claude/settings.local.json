        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'git commit'; then npx ts-node .claude/hooks/pre-commit.ts; fi",
            "timeout": 120,
            "statusMessage": "Running pre-commit validation..."
          }
        ]
      },
      {
        "matcher": "mcp__boss-ghost-mcp__*",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_NAME=\"$TOOL_NAME\" bash .claude/hooks/browser-mcp-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking browser MCP preference..."
          }
        ]
      },
      {
        "matcher": "mcp__chrome-devtools__*",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_NAME=\"$TOOL_NAME\" bash .claude/hooks/browser-mcp-reminder.sh",
            "timeout": 5,
            "statusMessage": "Checking browser MCP preference..."
          }
        ]
      }
    ],
    "PostToolUse": [
