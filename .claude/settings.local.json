            "timeout": 10,
            "statusMessage": "Loading FF expertise..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'git commit'; then npx ts-node .claude/hooks/pre-commit.ts; fi",
            "timeout": 120,
            "statusMessage": "Running pre-commit validation..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx ts-node .claude/hooks/token-tracker.ts 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Tracking tokens..."
          }
        ]
      }
    ]
