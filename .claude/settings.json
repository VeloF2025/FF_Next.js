{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run start:*)",
      "Bash(npx:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh run:*)",
      "Bash(gh repo:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/expert-load.js 2>&1 || true",
            "timeout": 10,
            "statusMessage": "Loading FF expertise..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q 'git commit'; then node .claude/hooks/pre-commit.js 2>&1 || true; fi",
            "timeout": 120,
            "statusMessage": "Running pre-commit validation..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q '/src/modules/'; then TOOL_INPUT=\"$TOOL_INPUT\" node .claude/hooks/tdd-reminder.js 2>&1 || true; TOOL_INPUT=\"$TOOL_INPUT\" node .claude/hooks/skill-gap-detector.js 2>&1 || true; fi",
            "timeout": 5,
            "statusMessage": "Checking TDD & skill coverage..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -q '/src/modules/'; then TOOL_INPUT=\"$TOOL_INPUT\" node .claude/hooks/tdd-reminder.js 2>&1 || true; TOOL_INPUT=\"$TOOL_INPUT\" node .claude/hooks/skill-gap-detector.js 2>&1 || true; fi",
            "timeout": 5,
            "statusMessage": "Checking TDD & skill coverage..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/token-tracker.js 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Tracking tokens..."
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_INPUT=\"$TOOL_INPUT\" TOOL_RESULT=\"$TOOL_RESULT\" node .claude/hooks/verified-workflow-trigger.js 2>&1 || true",
            "timeout": 3,
            "statusMessage": "Checking verified status..."
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=\"$TOOL_INPUT\" TOOL_RESULT=\"$TOOL_RESULT\" node .claude/hooks/auto-skill-creator.js 2>&1 || true",
            "timeout": 3,
            "statusMessage": "Checking skill creation..."
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_INPUT=\"$TOOL_INPUT\" TOOL_RESULT=\"$TOOL_RESULT\" node .claude/hooks/verified-workflow-trigger.js 2>&1 || true",
            "timeout": 3,
            "statusMessage": "Checking verified status..."
          },
          {
            "type": "command",
            "command": "TOOL_INPUT=\"$TOOL_INPUT\" TOOL_RESULT=\"$TOOL_RESULT\" node .claude/hooks/auto-skill-creator.js 2>&1 || true",
            "timeout": 3,
            "statusMessage": "Checking skill creation..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL_RESULT=\"$TOOL_RESULT\" node .claude/hooks/failed-task-analyzer.js 2>&1 || true",
            "timeout": 3,
            "statusMessage": "Analyzing task result..."
          },
          {
            "type": "command",
            "command": "if echo \"$TOOL_INPUT\" | grep -qE 'git (worktree add|checkout -b|switch -c)'; then TOOL_INPUT=\"$TOOL_INPUT\" node .claude/hooks/ticket-in-progress.js 2>&1 || true; fi",
            "timeout": 15,
            "statusMessage": "Updating ticket to in_progress..."
          }
        ]
      }
    ]
  }
}
